<%= turbo_frame_tag "results" do %>
  <div id="results-section" class="animate-in">

    <!-- ═══ Summary Header ═══ -->
    <div class="card card--gold animate-in animate-in--d1" style="border-color: var(--gold-pale);">
      <div class="card__header">
        <div class="card__icon card__icon--emerald">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <h3 class="card__title"><%= t("results.title") %></h3>
      </div>
      <div class="card__body">
        <div class="stats-grid">
          <div class="stat-card">
            <div class="stat-card__label"><%= t("results.estate_amount") %></div>
            <div class="stat-card__value"><%= number_with_delimiter(result.estate_amount.to_f.round(2)) %></div>
          </div>
          <div class="stat-card">
            <div class="stat-card__label"><%= t("results.base") %></div>
            <div class="stat-card__value"><%= result.base_denominator %></div>
          </div>
          <% if result.awl_applied %>
            <div class="stat-card stat-card--amber">
              <div class="stat-card__label"><%= t("results.after_awl") %></div>
              <div class="stat-card__value"><%= result.adjusted_denominator %></div>
            </div>
          <% end %>
          <% if result.radd_applied %>
            <div class="stat-card stat-card--sky">
              <div class="stat-card__label"><%= t("results.radd_applied") %></div>
              <div class="stat-card__value"><%= t("results.radd_note") %></div>
            </div>
          <% end %>
          <div class="stat-card">
            <div class="stat-card__label"><%= t("results.heir_count") %></div>
            <div class="stat-card__value"><%= result.heir_shares.sum(&:count) %></div>
          </div>
        </div>
      </div>
    </div>

    <!-- ═══ Shares Table ═══ -->
    <div class="card animate-in animate-in--d2">
      <div class="card__body" style="padding-top: 1.25rem;">
        <div class="results-table-wrap">
          <table class="results-table">
            <thead>
              <tr>
                <th><%= t("results.table.heir") %></th>
                <th><%= t("results.table.count") %></th>
                <th><%= t("results.table.share") %></th>
                <th><%= t("results.table.percentage") %></th>
                <th><%= t("results.table.per_person") %></th>
                <th><%= t("results.table.total") %></th>
              </tr>
            </thead>
            <tbody>
              <% result.heir_shares.each do |share| %>
                <tr>
                  <td>
                    <span class="heir-cell__name-ar"><%= t("heir_labels.#{share.heir_type}") %></span>
                    <br>
                    <span class="heir-cell__name-en"><%= t("heir_labels_en.#{share.heir_type}") %></span>
                  </td>
                  <td><span class="count-badge"><%= share.count %></span></td>
                  <td><span class="fraction"><%= share.total_share.numerator %>/<%= share.total_share.denominator %></span></td>
                  <td style="font-weight:500; color:var(--ink-light);"><%= "%.1f" % (share.total_share.to_f * 100) %>%</td>
                  <td><span class="amount"><%= number_with_delimiter(share.per_person_amount.to_f.round(2)) %></span></td>
                  <td><span class="amount amount--total"><%= number_with_delimiter(share.total_amount.to_f.round(2)) %></span></td>
                </tr>
                <% if share.reason_ar.present? %>
                  <tr class="reason-row">
                    <td colspan="6" style="padding-right: 1.5rem;">
                      <span class="reason-tag">
                        <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        <%= share.reason_ar %>
                      </span>
                    </td>
                  </tr>
                <% end %>
              <% end %>
            </tbody>
            <tfoot>
              <% total = result.heir_shares.sum { |s| s.total_share } %>
              <tr>
                <td><%= t("results.total_row") %></td>
                <td><%= result.heir_shares.sum(&:count) %></td>
                <td><span class="fraction"><%= total.numerator %>/<%= total.denominator %></span></td>
                <td><%= "%.1f" % (total.to_f * 100) %>%</td>
                <td></td>
                <td><span class="amount amount--total"><%= number_with_delimiter(result.heir_shares.sum { |s| s.total_amount.to_f }.round(2)) %></span></td>
              </tr>
            </tfoot>
          </table>
        </div>
      </div>
    </div>

    <!-- ═══ Visual Chart ═══ -->
    <div class="card animate-in animate-in--d3">
      <div class="card__header">
        <div class="card__icon card__icon--gold">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M20.488 9H15V3.512A9.025 9.025 0 0120.488 9z" />
          </svg>
        </div>
        <h3 class="card__title"><%= t("results.chart_title") %></h3>
      </div>
      <div class="card__body">
        <div class="bar-chart">
          <% result.heir_shares.each_with_index do |share, idx| %>
            <% pct = (share.total_share.to_f * 100).round(1) %>
            <div class="bar-row">
              <div class="bar-row__label"><%= t("heir_labels.#{share.heir_type}") %></div>
              <div class="bar-row__track">
                <div class="bar-row__fill bar-color-<%= idx % 12 %>" style="width: <%= [pct, 4].max %>%;">
                  <% if pct >= 10 %>
                    <span><%= pct %>%</span>
                  <% end %>
                </div>
              </div>
              <% if pct < 10 %>
                <div class="bar-row__pct"><%= pct %>%</div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- ═══ Blocked Heirs ═══ -->
    <% if result.blocked_heirs.any? %>
      <div class="blocked-panel animate-in animate-in--d4">
        <h4 class="blocked-panel__title">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
          </svg>
          <%= t("blocked.title") %>
        </h4>
        <% result.blocked_heirs.each do |blocked| %>
          <div class="blocked-item">
            <span class="blocked-item__name"><%= t("heir_labels.#{blocked[:heir_type]}") %></span>
            <span class="blocked-item__sep">|</span>
            <span class="blocked-item__reason"><%= blocked[:reason] %></span>
          </div>
        <% end %>
      </div>
    <% end %>

    <!-- ═══ Debug Info ═══ -->
    <% if result.debug_info.present? %>
      <div style="background:#1a1a2e; color:#e0e0e0; border-radius:0.5rem; padding:1rem 1.25rem; margin-bottom:1.5rem; font-family:monospace; font-size:0.75rem; direction:ltr; text-align:left; overflow-x:auto;">
        <div style="color:#FFD700; font-weight:bold; margin-bottom:0.5rem;">DEBUG — Calculator Trace</div>
        <div><strong style="color:#90EE90;">Input heirs:</strong> <%= result.debug_info[:input_heirs].inspect %></div>
        <div><strong style="color:#90EE90;">Active heirs (after blocking):</strong> <%= result.debug_info[:active_heirs].inspect %></div>
        <div><strong style="color:#FF6B6B;">Blocked keys:</strong> <%= result.debug_info[:blocked_keys].inspect %></div>
        <div><strong style="color:#87CEEB;">Fixed shares:</strong> <%= result.debug_info[:fixed_keys].inspect %></div>
        <div><strong style="color:#DDA0DD;">Residuary types:</strong> <%= result.debug_info[:residuary_types].inspect %></div>
        <div><strong style="color:#FFA500;">Total fixed:</strong> <%= result.debug_info[:total_fixed] %></div>
      </div>
    <% end %>

    <!-- ═══ Disclaimer ═══ -->
    <div class="disclaimer animate-in animate-in--d5">
      <%= t("app.disclaimer") %>
    </div>
  </div>

  <script>
    document.getElementById('results-section')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  </script>
<% end %>
