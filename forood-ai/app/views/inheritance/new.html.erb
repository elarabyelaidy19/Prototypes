<div data-controller="inheritance-form">
  <!-- Hero -->
  <div class="page-hero animate-in">
    <h2 class="page-hero__title"><%= t("calculator.title") %></h2>
    <div class="page-hero__divider">
      <span class="page-hero__diamond"></span>
    </div>
    <p class="page-hero__subtitle"><%= t("calculator.subtitle") %></p>
  </div>

  <%= form_with url: calculate_path, method: :post, data: { "inheritance-form-target": "form", turbo_frame: "results", action: "turbo:submit-start->inheritance-form#onSubmit turbo:submit-end->inheritance-form#onSubmitEnd" } do |f| %>

    <!-- ═══ Estate Info ═══ -->
    <div class="card card--gold animate-in animate-in--d1">
      <div class="card__header">
        <div class="card__icon card__icon--gold">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <h3 class="card__title"><%= t("estate.title") %></h3>
      </div>
      <div class="card__body">
        <div class="grid-2">
          <div>
            <label for="estate_amount" style="display:block; font-size:0.82rem; font-weight:500; color:var(--text-secondary); margin-bottom:0.375rem;">
              <%= t("estate.amount") %>
            </label>
            <input type="number" name="estate_amount" id="estate_amount" value="100000" min="0" step="0.01"
                   placeholder="<%= t('estate.amount_placeholder') %>"
                   style="width:100%; border:1px solid var(--border-warm); border-radius:0.5rem; padding:0.625rem 0.875rem; font-size:1.05rem; font-weight:600; color:var(--ink); background:#fff; outline:none; font-family:var(--font-body); transition: border-color 0.2s, box-shadow 0.2s;"
                   onfocus="this.style.borderColor='var(--emerald-600)'; this.style.boxShadow='0 0 0 3px rgba(26,122,90,0.12)'"
                   onblur="this.style.borderColor='var(--border-warm)'; this.style.boxShadow='none'"
                   required>
          </div>
          <div>
            <label style="display:block; font-size:0.82rem; font-weight:500; color:var(--text-secondary); margin-bottom:0.375rem;">
              <%= t("estate.deceased_gender") %>
            </label>
            <div class="gender-toggle">
              <label class="gender-toggle__option">
                <input type="radio" name="deceased_gender" value="male" checked
                       data-action="change->inheritance-form#genderChanged"
                       class="gender-toggle__radio">
                <div class="gender-toggle__label"><%= t("estate.male") %></div>
              </label>
              <label class="gender-toggle__option">
                <input type="radio" name="deceased_gender" value="female"
                       data-action="change->inheritance-form#genderChanged"
                       class="gender-toggle__radio">
                <div class="gender-toggle__label"><%= t("estate.female") %></div>
              </label>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ═══ Heirs ═══ -->
    <div class="card animate-in animate-in--d2">
      <div class="card__header">
        <div class="card__icon card__icon--emerald">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
          </svg>
        </div>
        <h3 class="card__title"><%= t("heirs.title") %></h3>
      </div>
      <div class="card__body">

        <%# ── Spouse ── %>
        <div style="margin-bottom:1.25rem;">
          <div class="section-label"><%= t("heirs.spouse.title") %></div>
          <div class="grid-2">
            <div data-inheritance-form-target="wifeField">
              <%= render "heir_input", name: "wife", label: t("heirs.spouse.wife"), max: 4, default: 0 %>
            </div>
            <div data-inheritance-form-target="husbandField" style="display:none;">
              <%= render "heir_input", name: "husband", label: t("heirs.spouse.husband"), max: 1, default: 0 %>
            </div>
          </div>
        </div>

        <%# ── Parents ── %>
        <div style="margin-bottom:1.25rem;">
          <div class="section-label"><%= t("heirs.parents.title") %></div>
          <div class="grid-2">
            <%= render "heir_input", name: "father", label: t("heirs.parents.father"), max: 1, default: 0 %>
            <%= render "heir_input", name: "mother", label: t("heirs.parents.mother"), max: 1, default: 0 %>
          </div>
        </div>

        <%# ── Grandparents ── %>
        <div style="margin-bottom:1.25rem;">
          <div class="section-label"><%= t("heirs.grandparents.title") %></div>
          <div class="grid-2">
            <%= render "heir_input", name: "grandfather", label: t("heirs.grandparents.grandfather"), max: 1, default: 0 %>
            <%= render "heir_input", name: "grandmother", label: t("heirs.grandparents.grandmother"), max: 2, default: 0 %>
          </div>
        </div>

        <%# ── Children ── %>
        <div style="margin-bottom:1.25rem;">
          <div class="section-label"><%= t("heirs.children.title") %></div>
          <div class="grid-2">
            <%= render "heir_input", name: "son", label: t("heirs.children.son"), max: 20, default: 0 %>
            <%= render "heir_input", name: "daughter", label: t("heirs.children.daughter"), max: 20, default: 0 %>
          </div>
        </div>

        <%# ── Grandchildren ── %>
        <div style="margin-bottom:1.25rem;">
          <div class="section-label"><%= t("heirs.grandchildren.title") %></div>
          <div class="grid-2">
            <%= render "heir_input", name: "sons_son", label: t("heirs.grandchildren.sons_son"), max: 20, default: 0 %>
            <%= render "heir_input", name: "sons_daughter", label: t("heirs.grandchildren.sons_daughter"), max: 20, default: 0 %>
          </div>
        </div>

        <%# ── Full Siblings ── %>
        <div style="margin-bottom:1.25rem;">
          <div class="section-label"><%= t("heirs.full_siblings.title") %></div>
          <div class="grid-2">
            <%= render "heir_input", name: "full_brother", label: t("heirs.full_siblings.full_brother"), max: 20, default: 0 %>
            <%= render "heir_input", name: "full_sister", label: t("heirs.full_siblings.full_sister"), max: 20, default: 0 %>
          </div>
        </div>

        <%# ── Paternal Siblings ── %>
        <div style="margin-bottom:1.25rem;">
          <div class="section-label"><%= t("heirs.paternal_siblings.title") %></div>
          <div class="grid-2">
            <%= render "heir_input", name: "paternal_brother", label: t("heirs.paternal_siblings.paternal_brother"), max: 20, default: 0 %>
            <%= render "heir_input", name: "paternal_sister", label: t("heirs.paternal_siblings.paternal_sister"), max: 20, default: 0 %>
          </div>
        </div>

        <%# ── Maternal Siblings ── %>
        <div>
          <div class="section-label"><%= t("heirs.maternal_siblings.title") %></div>
          <div class="grid-2">
            <%= render "heir_input", name: "maternal_brother", label: t("heirs.maternal_siblings.maternal_brother"), max: 20, default: 0 %>
            <%= render "heir_input", name: "maternal_sister", label: t("heirs.maternal_siblings.maternal_sister"), max: 20, default: 0 %>
          </div>
        </div>

      </div>
    </div>

    <!-- ═══ Submit ═══ -->
    <div class="animate-in animate-in--d3" style="text-align:center; padding:0.5rem 0 1rem;">
      <button type="submit" class="btn-submit" data-inheritance-form-target="submitBtn">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
        </svg>
        <span data-inheritance-form-target="submitText"><%= t("calculator.submit") %></span>
      </button>
    </div>
  <% end %>

  <!-- Results Frame -->
  <div style="margin-top:1rem;">
    <%= turbo_frame_tag "results" %>
  </div>
</div>
