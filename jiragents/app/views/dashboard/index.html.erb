<%= turbo_stream_from "tasks" %>

<div class="max-w-5xl mx-auto py-10 px-4 sm:px-6">
  <div class="mb-10">
    <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">Dashboard</h1>
    <p class="text-gray-500 mt-1">Command center for your AI agents</p>
  </div>

  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-10">
    <div class="stat-card stat-card-teal">
      <div class="text-3xl font-extrabold text-teal-600 font-mono"><%= @agents_count %></div>
      <div class="text-sm text-gray-500 mt-1.5 font-medium">Agents</div>
    </div>
    <div class="stat-card stat-card-amber">
      <div class="text-3xl font-extrabold text-amber-600 font-mono"><%= @tasks_by_status["pending"] || 0 %></div>
      <div class="text-sm text-gray-500 mt-1.5 font-medium">Pending</div>
    </div>
    <div class="stat-card stat-card-teal">
      <div class="text-3xl font-extrabold text-teal-600 font-mono"><%= @tasks_by_status["running"] || 0 %></div>
      <div class="text-sm text-gray-500 mt-1.5 font-medium">Running</div>
    </div>
    <div class="stat-card stat-card-emerald">
      <div class="text-3xl font-extrabold text-emerald-600 font-mono"><%= @tasks_by_status["completed"] || 0 %></div>
      <div class="text-sm text-gray-500 mt-1.5 font-medium">Completed</div>
    </div>
  </div>

  <h2 class="section-label mb-4">Recent Tasks</h2>

  <% if @recent_tasks.any? %>
    <div class="space-y-3">
      <% @recent_tasks.each_with_index do |task, i| %>
        <div class="animate-slide-up delay-<%= [i + 1, 5].min %>">
          <%= render "tasks/card", task: task %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="card p-14 text-center">
      <div class="w-12 h-12 rounded-2xl bg-teal-50 border border-teal-100 flex items-center justify-center mx-auto mb-4">
        <svg width="20" height="20" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M7 1v12M1 7h12" stroke="#14b8a6" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </div>
      <p class="text-gray-700 font-semibold">No tasks yet</p>
      <p class="text-gray-500 mt-1 text-sm">Create an agent, then assign your first task.</p>
      <div class="flex gap-3 justify-center mt-6">
        <%= link_to "New Agent", new_agent_path, class: "btn-secondary" %>
        <%= link_to new_task_path, class: "btn-primary" do %>
          <svg class="icon-inline" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M7 1v12M1 7h12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
          New Task
        <% end %>
      </div>
    </div>
  <% end %>
</div>
