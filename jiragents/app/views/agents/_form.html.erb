<%= form_with(model: agent, class: "space-y-6") do |form| %>
  <% if agent.errors.any? %>
    <div class="bg-rose-50 border border-rose-200 rounded-xl p-4">
      <h2 class="text-rose-700 font-semibold text-sm">Please fix the following errors:</h2>
      <ul class="mt-2 list-disc list-inside text-rose-600 text-sm">
        <% agent.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, class: "block text-sm font-medium text-gray-700 mb-1.5" %>
    <%= form.text_field :name, class: "input-field", placeholder: "e.g. Sara, Omar, Alex" %>
  </div>

  <div>
    <%= form.label :description, class: "block text-sm font-medium text-gray-700 mb-1.5" %>
    <%= form.text_area :description, rows: 3, class: "input-field", placeholder: "What is this agent about?" %>
  </div>

  <div>
    <%= form.submit class: "btn-primary" %>
  </div>
<% end %>
